# =====================================================================
#  AURA — نموذج متغيرات البيئة
#  انسخه إلى .env محلياً:  cp .env.example .env
#  ولا ترفع .env إلى Git أبداً (موجود في .gitignore)
# =====================================================================

# ---------- قاعدة البيانات (PostgreSQL 15+) ----------
# محلياً:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura?schema=public"

# في الإنتاج (Neon / Supabase / RDS …) استخدم رابط الاتصال المجمّع مع SSL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ---------- المصادقة (Auth.js v5) ----------
# مفتاح توقيع الجلسات — ولّده بأمر:  openssl rand -base64 32
AUTH_SECRET="ضع-هنا-قيمة-عشوائية-٦٤-حرفاً"

# محلياً فقط. على Vercel يُكتشف العنوان تلقائياً (trustHost مفعّل)
AUTH_URL="http://localhost:3000"

# ---------- التحليلات (PostHog) ----------
# مفتاح المشروع العام من PostHog → Settings → Project → Project API Key
# (يظهر في المتصفح، لذلك هو ليس سراً — لكن اتركه فارغاً لتعطيل التحليلات)
NEXT_PUBLIC_POSTHOG_KEY=""

# مضيف الـ API: https://us.i.posthog.com أو https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---------- التواصل ----------
# رقم واتساب المتجر بالصيغة الدولية: كود الدولة + الرقم، بلا + وبلا مسافات
NEXT_PUBLIC_WHATSAPP_PHONE="966500000000"
